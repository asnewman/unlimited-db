# Copy to .env (install.sh does this for you).
# Values containing $ or quotes should be wrapped in single quotes.

# DNS name pointing at this server. Used for the dashboard's HTTPS certificate
# and as the host in every connection URI.
DOMAIN=db.example.com

# Password for the admin dashboard.
ADMIN_PASSWORD='change-me'

# Postgres superuser password (used only by the dashboard, never shown to you).
POSTGRES_PASSWORD=change-me

# Random secret used to sign the dashboard's login cookie.
SESSION_SECRET=change-me
